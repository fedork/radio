# Default-deny, then re-admit source and small data files.
*
!/**/
!*.*

# Bulk solver output. Never committed - archived to the artifact store instead.
# See docs/data.md for the index and how to fetch.
*.txt
*.dSYM
*.provenance

# Local environment and OS noise
.venv/
__pycache__/
*.pyc
.DS_Store

# Certification excerpts - the log lines that back the tables. Small and load-bearing.
!evidence/*.txt

# Repo-local gh credentials (see tools/artifacts.sh). Never commit.
.gh/

# Local bulk-run workspace. Final logs are archived through tools/artifacts.sh, never committed.
.artifacts/

# Small artifacts that ARE tracked (these are proofs and source-of-truth data,
# listed explicitly so the *.txt rule above can never swallow them again).
!witnesses/*.tree
!data/**/*.csv
!docs/**/*.md

# Training data for the BY_ML split-ordering model (radiobase_ml_order_model.h is generated from
# this by tools/ml/export_ordering_model.py) - small (tens of KB), labeled by the trusted solver
# itself, and now the reproducibility source for weights embedded in radiobase.c. Committed
# 2026-08-24 rather than left as a /tmp artifact, same reasoning as the evidence/*.txt rule above.
!data/ml_order/*.txt
